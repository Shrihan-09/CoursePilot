# CoursePilot — example environment file.
# Copy to `.env` and fill in real values. `.env` is gitignored.
#
# NOTE: no value in this file is a Rutgers-derived fact. Anything that must
# come from an authoritative Rutgers source is deliberately left blank and
# marked TODO(rutgers-source).

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
COURSEPILOT_ENV=local           # local | ci | staging | production
LOG_LEVEL=INFO
DEBUG=true

# ---------------------------------------------------------------------------
# Database (PostgreSQL + pgvector)
# ---------------------------------------------------------------------------
POSTGRES_USER=coursepilot
POSTGRES_PASSWORD=coursepilot
POSTGRES_DB=coursepilot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Async driver, used by the FastAPI app.
DATABASE_URL=postgresql+psycopg://coursepilot:coursepilot@localhost:5432/coursepilot
# Sync driver, used by Alembic migrations and the ingestion CLI.
DATABASE_URL_SYNC=postgresql+psycopg://coursepilot:coursepilot@localhost:5432/coursepilot

# Separate database for the `db`-marked integration tests. Those tests
# TRUNCATE every table, so they must NEVER point at the development database.
# Takes precedence over DATABASE_URL_SYNC in the test suite.
# Create it once with:
#   docker exec coursepilot-db psql -U coursepilot -d postgres \
#     -c "CREATE DATABASE coursepilot_test OWNER coursepilot;"
TEST_DATABASE_URL=postgresql+psycopg://coursepilot:coursepilot@localhost:5432/coursepilot_test

# ---------------------------------------------------------------------------
# Backend API
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# LLM provider abstraction
# ---------------------------------------------------------------------------
# Which provider implementation to bind at startup.
#   echo      -> deterministic fake, no network. Default for local/CI/tests.
#   anthropic -> real provider (NOT implemented yet)
LLM_PROVIDER=echo

# Logical model roles, so callers never hard-code a model string.
# `claude-opus-5` is the current default reasoning model.
LLM_MODEL_PLANNER=claude-opus-5
LLM_MODEL_ROUTER=claude-opus-5
# Effort trades thoroughness against token spend: low|medium|high|xhigh|max
LLM_EFFORT=high

ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Retrieval (not implemented yet — see docs/RAG_ARCHITECTURE.md)
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DIM=1024
RETRIEVAL_STRATEGY=hybrid       # bm25 | vector | hybrid
RERANKER_ENABLED=false

# ---------------------------------------------------------------------------
# Frontend (Next.js). Anything prefixed NEXT_PUBLIC_ ships to the browser.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# ---------------------------------------------------------------------------
# Ingestion — TODO(rutgers-source)
# ---------------------------------------------------------------------------
# Every value below must be sourced from official Rutgers documentation or a
# Rutgers-provided data feed. Do NOT guess these. Left blank on purpose.
RUTGERS_COURSE_DATA_BASE_URL=
RUTGERS_CATALOG_BASE_URL=
RUTGERS_ACADEMIC_TERM=
INGESTION_USER_AGENT=CoursePilot/0.1 (contact: set-me@example.com)
INGESTION_RATE_LIMIT_RPS=1

# --- Grounded explanations (Phase 5.2) ---
# Separate from LLM_PROVIDER on purpose: the explanation layer and the future
# agent layer are different consumers, and enabling one must not silently
# enable the other. Credentials/model names are reused from the LLM_* settings.
#   none      - deterministic explanations only (default; no key required)
#   echo      - non-network fake, for exercising the model path
#   anthropic - live provider; requires ANTHROPIC_API_KEY and `pip install -e '.[ai]'`
EXPLANATION_PROVIDER=none
EXPLANATION_TIMEOUT_SECONDS=30.0
EXPLANATION_MAX_QUERY_CHARS=200

# --- API security (Phase 5.3) ---
# Development authentication: Authorization: Bearer devtoken:<student_ref>
# OFF by default, refused outright when COURSEPILOT_ENV=production, and NOT a
# production mechanism. Real deployments need SSO/JWT before holding real
# student data.
# Which verifier resolves a bearer credential (Phase 5.4).
#   none - refuse every credential (fail closed; the default)
#   dev  - NON-PRODUCTION subject tokens "Bearer dev:<subject>", also needs
#          DEV_AUTH_ENABLED=true, and is refused outright in production
#   oidc - standards-based JWT verification against a JWKS endpoint
AUTH_PROVIDER=none

# OIDC settings. Required when AUTH_PROVIDER=oidc; incomplete settings fail
# CLOSED rather than falling back to something permissive.
# NOTE: Rutgers publicly documents CAS/Shibboleth/LDAP rather than OIDC, and
# integration requires Rutgers IT approval - see DATA_MODEL.md 26.7.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=

DEV_AUTH_ENABLED=false

# Rate limiting. In-memory and PER PROCESS: N workers means N times the
# limit, so this is a development control, not a production one.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
# Lower on purpose - every model call costs money, so spend gets its own
# budget rather than sharing the request budget.
RATE_LIMIT_MODEL_CALLS=10
RATE_LIMIT_WINDOW_SECONDS=60.0
# Administrative student linking (Phase 5.5). Not a brute-force control -
# the linking workflow contains no secret to guess. It bounds the BLAST
# RADIUS of a compromised administrator credential.
RATE_LIMIT_LINK_OPERATIONS=10

# There is no ADMIN_* setting, and that is deliberate: administrative
# authority lives in user_account.is_admin, granted by
#   python -m app.cli.dev_bootstrap grant-admin --provider <p> --subject <s>
# which refuses to run when COURSEPILOT_ENV=production.

# Server-owned AI cost bounds. None of these is a request field; a client
# cannot raise them.
EXPLANATION_MAX_OUTPUT_TOKENS=1500
EXPLANATION_MAX_CONTEXT_CHARS=12000
EXPLANATION_MAX_PROVIDER_CALLS=1
# Transient failures only (connection, 408, 409, 429, 5xx). Each retry is
# another billable call.
EXPLANATION_PROVIDER_RETRIES=1
