# ---------- Secrets ----------
.env
.env.*
!.env.example
*.pem
*.key
# Apple APNs auth keys (Phase 6.9) - never committed
*.p8
secrets/

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/

# ---------- Node / Next.js ----------
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------- Editors / OS ----------
.vscode/
.idea/
.claude/
.DS_Store
Thumbs.db
desktop.ini
/Microsoft/Windows/PowerShell/ModuleAnalysisCache

# ---------- Local data ----------
# Raw scraped/ingested Rutgers payloads are large and are NOT the source of
# truth; they are reproducible artifacts. Keep them out of git.
data/raw/
data/interim/
# Phase 7.0: uploaded transcripts exist only while being read; never commit one.
**/data/uploads/
*.sqlite
*.db
pgdata/

# ---------- Docker ----------
docker-compose.override.yml

# ---------- Phase 7.3: private developer/student material (PHASE_7_3_PLAN.md §2) ----------
# Session state, HAR captures and real DN/WebReg exports never enter Git.
data/private/
# The out-of-repo private folder (C:\coursepilot-private) must never be copied
# or linked in. Git cannot see paths outside the repo; this catches a copy.
coursepilot-private/
**/coursepilot-private/
*.har
*state*.json

# Local working output (test runs, previews, probes). Never committed; PR bodies live in docs/pr/.
scratchpad/

# ---------- Test and scratch output ----------
# Never committed. New test output belongs in a fresh folder under the system
# temp directory (pytest's default tmp_path root), never in the repository or
# OneDrive: app/core/test_output_guard.py refuses an in-repo --basetemp.
.tmp_*/
**/.tmp_*/
ingestion/.tmp_*
backend/.tmp_*
frontend/.tmp_*
test-output/
**/test-output/
test-results/
**/test-results/
playwright-report/
**/playwright-report/
.pytest-tmp/
